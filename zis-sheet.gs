function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('ZIS дашборд')
    .addItem('Собрать структуру', 'buildStructure')
    .addItem('Выгрузить JSON', 'exportJson')
    .addToUi();
}

function buildStructure() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  SEED.forEach(function (t) {
    var sh = ss.getSheetByName(t.name);
    if (sh) sh.clear(); else sh = ss.insertSheet(t.name);
    var width = Math.max.apply(null, t.rows.map(function (r) { return r.length; }));
    var rows = t.rows.map(function (r) {
      var c = r.slice();
      while (c.length < width) c.push('');
      return c;
    });
    sh.getRange(1, 1, rows.length, width).setValues(rows);
    sh.getRange(1, 1, 2, width).setFontWeight('bold').setBackground('#eef7e6');
    sh.setFrozenRows(2);
    sh.autoResizeColumns(1, width);
  });
  // лишний лист по умолчанию убираем, если он пустой
  var def = ss.getSheetByName('Лист1') || ss.getSheetByName('Sheet1');
  if (def && ss.getSheets().length > 1 && def.getLastRow() === 0) ss.deleteSheet(def);
  SpreadsheetApp.getUi().alert('Готово. Листов: ' + SEED.length);
}

/* обратный перевод слов в коды дашборда */
var LVL = { 'халықаралық': 'int', 'республикалық': 'rep', 'облыстық': 'obl', 'қалалық': 'city' };
var PLC = { '1': 1, '2': 2, '3': 3, 'бас жүлде': 'gp', 'грамота': 'gr', 'алғыс хат': 'let' };

function rowsOf(name) {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(name);
  if (!sh) return [];
  var v = sh.getDataRange().getValues();
  return v.slice(2).filter(function (r) { return String(r[0]).trim() !== ''; });
}
function num(x) { return x === '' || x === null ? null : Number(x); }
function str(x) { return String(x == null ? '' : x).trim(); }

function collect() {
  var out = { schools: [], staff: [], wins: [], growth: [], clubs: [], goals: [], texts: [], settings: {} };

  rowsOf('Мектептер').forEach(function (r) {
    out.schools.push({ id: str(r[0]), name: str(r[1]), city: str(r[2]), year: num(r[3]),
      director: str(r[4]), students: num(r[5]), capacity: num(r[6]), reserve: num(r[7]),
      teachers: num(r[8]), graduates: num(r[9]), granted: num(r[10]) });
  });
  rowsOf('Кадрлар').forEach(function (r) {
    out.staff.push({ id: str(r[0]), msc: num(r[1]), phd: num(r[2]), mst: num(r[3]),
      res: num(r[4]), exp: num(r[5]), mod: num(r[6]), ped: num(r[7]) });
  });
  rowsOf('Жеңістер').forEach(function (r) {
    out.wins.push({ s: str(r[0]), n: str(r[1]), l: LVL[str(r[2])] || '',
      p: PLC[str(r[3])] !== undefined ? PLC[str(r[3])] : 'none',
      w: str(r[4]), c: str(r[5]), t: str(r[6]) ? 1 : 0, q: num(r[7]), year: str(r[8]) });
  });
  rowsOf('Өсу').forEach(function (r) {
    out.growth.push({ s: str(r[0]), kz: str(r[1]), ru: str(r[2]), from: num(r[3]), to: num(r[4]) });
  });
  rowsOf('Үйірмелер').forEach(function (r) {
    if (str(r[1])) out.clubs.push({ s: str(r[0]), name: str(r[1]), area: str(r[2]), lead: str(r[3]) });
  });
  rowsOf('Стратегия').forEach(function (r) {
    out.goals.push({ ic: str(r[0]), short: str(r[1]), kind: str(r[2]),
      now: num(r[3]), tgt: num(r[4]), kz: str(r[5]), ru: str(r[6]) });
  });
  rowsOf('Мәтіндер').forEach(function (r) {
    out.texts.push({ type: str(r[0]), title: str(r[1]), kz: str(r[2]), ru: str(r[3]) });
  });
  rowsOf('Баптаулар').forEach(function (r) { out.settings[str(r[0])] = r[1]; });

  return out;
}

/**
 * JSON API для дашборда.
 * Развернуть: Deploy -> New deployment -> Web app.
 * Execute as: Me. Who has access: Anyone.
 */
function doGet() {
  return ContentService
    .createTextOutput(JSON.stringify({
      ok: true,
      version: 1,
      generatedAt: new Date().toISOString(),
      spreadsheetId: SpreadsheetApp.getActiveSpreadsheet().getId(),
      data: collect()
    }))
    .setMimeType(ContentService.MimeType.JSON);
}

function exportJson() {
  var json = JSON.stringify(collect(), null, 1);
  var html = HtmlService.createHtmlOutput(
    '<p style="font:13px system-ui">Скопируйте всё и передайте в проект дашборда.</p>' +
    '<textarea style="width:100%;height:420px;font:12px monospace" onclick="this.select()">' +
    json.replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</textarea>')
    .setWidth(760).setHeight(520);
  SpreadsheetApp.getUi().showModalDialog(html, 'JSON для дашборда');
}
